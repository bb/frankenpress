# Copy to .env and adjust. Never commit the real .env.

# Hostname(s) Caddy serves and gets certificates for. Behind a load balancer
# that terminates TLS, use a port instead, e.g. ":80".
SERVER_NAME=example.com

# Optional: email address for the Let's Encrypt account (expiry notices)
#CADDY_GLOBAL_OPTIONS=email admin@example.com

# The theme and plugin code editors in wp-admin are off, so a stolen admin
# login can't run PHP through them. Set to 0 to turn them back on.
#DISALLOW_FILE_EDIT=0

# Outgoing mail through your SMTP relay (see "Sending Email" in the README)
MSMTP_HOST=smtp.example.com
MSMTP_PORT=587
MSMTP_USER=wordpress@example.com
MSMTP_PASSWORD=change-me
MSMTP_FROM=wordpress@example.com

DB_NAME=wordpress
DB_USER=wordpress
# Use long random values, e.g. from: openssl rand -base64 32
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# phpMyAdmin port on 127.0.0.1 (only with: docker compose --profile tools up -d)
PHPMYADMIN_PORT=8080
