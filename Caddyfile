{
	# Real hostnames get publicly trusted certificates (Let's Encrypt/ZeroSSL);
	# localhost and IP addresses automatically use Caddy's local CA.
	auto_https disable_redirects # This is required to avoid redirect loops when using a reverse proxy and cloud load balancers.

	# Behind a load balancer or reverse proxy, take the client IP from
	# X-Forwarded-For, but only when the request comes from a trusted proxy
	# (default: private network ranges). Set TRUSTED_PROXIES to your proxies'
	# CIDRs to narrow this down, e.g. "10.0.1.0/24".
	servers {
		trusted_proxies static {$TRUSTED_PROXIES:private_ranges}
		client_ip_headers X-Forwarded-For
	}

	{$CADDY_GLOBAL_OPTIONS}

	frankenphp {
		#worker /path/to/your/worker.php
		{$FRANKENPHP_CONFIG}
	}

	# https://caddyserver.com/docs/caddyfile/directives#sorting-algorithm
	order php_server before file_server
	order php before file_server
}

{$CADDY_EXTRA_CONFIG}

# Internal healthcheck endpoint, reachable only from inside the container.
# It runs a tiny PHP script outside the web root, so the container is healthy
# when PHP executes, independent of SERVER_NAME and of the database.
http://127.0.0.1:2080 {
	bind 127.0.0.1
	root * /usr/local/share/frankenpress/health
	php_server
}

## Need to set all hosts with port for the cloud.
# You may not have the hostname being called due to dynamic IPs and load balancers.
# Allowing all hosts on port 80 for health checks, local dev & cases where the hostname is unknown.
{$SERVER_NAME:localhost} {
	# Never run PHP from writable upload folders, including the
	# /evil.php/extra path-info trick. Turns an upload bug into a 404
	# instead of remote code execution.
	@uploaded_php path_regexp (?i)^/wp-content/uploads/.*\.(php\d*|phtml|phar|pht|phps)(/|$)

	# Hidden files (.git, .env, .htaccess, ...) and backups/logs left in the web root
	@sensitive {
		path_regexp sensitive (?i)/\.[^/]|\.(bak|old|orig|save|swp|swo|tmp|sql|sql\.gz|log)$
		not path /.well-known/*
	}

	respond @uploaded_php 404
	respond @sensitive 404

	@static {
		file
		path *.ico *.css *.js *.gif *.jpg *.jpeg *.png *.webp *.avif *.svg *.woff *.woff2 *.ttf
	}
	header @static Cache-Control "public, max-age=2592000"

	# "?" only sets a header when WordPress hasn't sent one itself
	header {
		?X-Content-Type-Options nosniff
		?Referrer-Policy strict-origin-when-cross-origin
		?X-Frame-Options SAMEORIGIN
	}

	root * /var/www/html/
	encode br zstd gzip

	{$CADDY_SERVER_EXTRA_DIRECTIVES}

	php_server {
		# FrankenPHP passes the proxy's address to PHP by default; hand it the
		# client IP resolved via trusted_proxies so WordPress, login limiters and
		# security plugins see real visitors instead of the load balancer.
		env REMOTE_ADDR {client_ip}
	}
}
