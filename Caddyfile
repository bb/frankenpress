{
	# Real hostnames get publicly trusted certificates (Let's Encrypt/ZeroSSL);
	# localhost and IP addresses automatically use Caddy's local CA.
	auto_https disable_redirects # This is required to avoid redirect loops when using a reverse proxy and cloud load balancers.

	servers {
		# Behind a load balancer or reverse proxy, take the client IP from
		# X-Forwarded-For, but only when the request comes from a trusted proxy
		# (default: private network ranges). Set TRUSTED_PROXIES to your proxies'
		# CIDRs to narrow this down, e.g. "10.0.1.0/24".
		trusted_proxies static {$TRUSTED_PROXIES:private_ranges}
		client_ip_headers X-Forwarded-For

		# Bound how long a client may take, so slow or stalled connections
		# can't hold PHP threads. Caddy's defaults are no limit for the body
		# and the response. read_body allows large uploads over slow links;
		# write covers PHP's run time (imports and updates may take minutes)
		# plus sending the response.
		timeouts {
			read_header {$TIMEOUT_READ_HEADER:10s}
			read_body {$TIMEOUT_READ_BODY:10m}
			write {$TIMEOUT_WRITE:10m}
			idle {$TIMEOUT_IDLE:5m}
		}
	}

	{$CADDY_GLOBAL_OPTIONS}

	frankenphp {
		#worker /path/to/your/worker.php
		{$FRANKENPHP_CONFIG}
	}

	# https://caddyserver.com/docs/caddyfile/directives#sorting-algorithm
	order php_server before file_server
	order php before file_server
}

{$CADDY_EXTRA_CONFIG}

# Internal healthcheck endpoint, reachable only from inside the container.
# It runs a tiny PHP script outside the web root, so the container is healthy
# when PHP executes, independent of SERVER_NAME and of the database.
http://127.0.0.1:2080 {
	bind 127.0.0.1
	root * /usr/local/share/frankenpress/health
	php_server
}

# Default ":80": plain HTTP on port 80 for any hostname, which is what a
# container behind a load balancer or reverse proxy needs, and what
# `docker run -p 80:80` expects. For HTTPS with a public certificate, set
# SERVER_NAME to your hostname(s), e.g. "example.com" or "example.com, :80".
{$SERVER_NAME::80} {
	# Liveness for load balancers and uptime checks: answered by Caddy
	# without PHP or the database, so maintenance or a database outage
	# doesn't take the container out of rotation.
	respond /healthz "ok" 200

	# Refuse requests that announce a body above the upload limit (413) before
	# PHP starts on them. Default: 536870912 bytes = php.ini's 512M. Caddy's
	# request_body max_size is deliberately not used: with FrankenPHP it
	# truncates the body silently and PHP processes the cut-off data. Chunked
	# requests without Content-Length are still capped by PHP's post_max_size.
	@too_large `{http.request.header.Content-Length} != "" && int({http.request.header.Content-Length}) > {$REQUEST_BODY_MAX_BYTES:536870912}`
	respond @too_large "Request body too large" 413

	# Never run PHP from writable upload folders, including the
	# /evil.php/extra path-info trick. Turns an upload bug into a 404
	# instead of remote code execution.
	@uploaded_php path_regexp (?i)^/wp-content/uploads/.*\.(php\d*|phtml|phar|pht|phps)(/|$)

	# Hidden files (.git, .env, .htaccess, ...) and backups/logs left in the web root
	@sensitive {
		path_regexp sensitive (?i)/\.[^/]|\.(bak|old|orig|save|swp|swo|tmp|sql|sql\.gz|log)$
		not path /.well-known/*
	}

	respond @uploaded_php 404
	respond @sensitive 404

	# Optional: refuse XML-RPC (BLOCK_XMLRPC=1), a common password-guessing
	# target. Off by default because Jetpack and the mobile apps still use it.
	@xmlrpc {
		path /xmlrpc.php
		expression `"{$BLOCK_XMLRPC:0}" == "1"`
	}
	respond @xmlrpc 403

	# /wp-json/... works on every site: without pretty permalinks WordPress
	# only answers the REST API via ?rest_route=, so /wp-json/ would return
	# the home page. Rewriting to the query form works with any permalink
	# setting; method, body and existing query parameters are kept.
	@wpjson_root path /wp-json /wp-json/
	rewrite @wpjson_root /index.php?rest_route=/&{query}
	@wpjson_child path_regexp wpjson ^/wp-json(/.+)$
	rewrite @wpjson_child /index.php?rest_route={re.wpjson.1}&{query}

	# Behind a TLS-terminating proxy, tell PHP the request was HTTPS when a
	# trusted proxy (TRUSTED_PROXIES) says so via X-Forwarded-Proto or
	# CloudFront-Forwarded-Proto. The result reaches PHP as server variables
	# (FRANKENPRESS_HTTPS, FRANKENPRESS_TRUSTED_PROXY, set in php_server
	# below), not as headers: client headers always arrive as HTTP_*, so no
	# header spelling can forge them. frankenpress-prepend.php then sets
	# $_SERVER['HTTPS'], and removes HTTP_X_FORWARDED_PROTO and
	# HTTP_CLOUDFRONT_FORWARDED_PROTO from requests that didn't come from a
	# trusted proxy, because WordPress's stock wp-config.php would otherwise
	# believe any visitor claiming HTTPS. Working on PHP's normalized names
	# covers every "-"/"_" spelling of those headers.
	@forwarded_https `{http.vars.trusted_proxy} == true && ({header.X-Forwarded-Proto}.lowerAscii().startsWith("https") || {header.CloudFront-Forwarded-Proto}.lowerAscii().startsWith("https"))`
	vars @forwarded_https frankenpress_https on

	@static {
		file
		path *.ico *.css *.js *.gif *.jpg *.jpeg *.png *.webp *.avif *.svg *.woff *.woff2 *.ttf
	}
	header @static Cache-Control "public, max-age=2592000"

	# "?" only sets a header when WordPress hasn't sent one itself.
	# The Server header ("FrankenPHP Caddy") is dropped to avoid fingerprinting.
	header {
		?X-Content-Type-Options nosniff
		?Referrer-Policy strict-origin-when-cross-origin
		?X-Frame-Options SAMEORIGIN
		-Server
	}

	# Optional HSTS: set HSTS to the header value, e.g. "max-age=31536000"
	# (add "; includeSubDomains" only if every subdomain serves HTTPS).
	# Only sent on HTTPS requests, direct or forwarded by a trusted proxy.
	@hsts `"{$HSTS:}" != "" && ({http.request.scheme} == "https" || ({http.vars.trusted_proxy} == true && ({header.X-Forwarded-Proto}.lowerAscii().startsWith("https") || {header.CloudFront-Forwarded-Proto}.lowerAscii().startsWith("https"))))`
	header @hsts Strict-Transport-Security "{$HSTS}"

	root * /var/www/html/
	encode br zstd gzip

	# Optional (SUPERCACHE=1): serve the static pages of the WP Super Cache
	# plugin straight from disk, without PHP, the way its mod_rewrite rules
	# do on Apache. Same conditions as those rules: GET/HEAD, no query
	# string, no login/comment/password cookie, and a cached file for this
	# host and path. Only paths ending in "/" (WordPress's default
	# permalinks), so other URLs still get WordPress's redirects. Anything
	# else, or a missing file, falls through to PHP as before.
	# HTTPS pages are cached as index-https.html. Checked here directly, not
	# via frankenpress_https: Caddy may run this vars before that one.
	@supercache_https `{http.request.scheme} == "https" || ({http.vars.trusted_proxy} == true && ({header.X-Forwarded-Proto}.lowerAscii().startsWith("https") || {header.CloudFront-Forwarded-Proto}.lowerAscii().startsWith("https"))) || "{$FORCE_HTTPS:0}".lowerAscii() in ["1", "true", "yes", "on"]`
	vars @supercache_https frankenpress_supercache_https -https
	@supercache {
		expression `"{$SUPERCACHE:0}" == "1" && {query} == ""`
		method GET HEAD
		path */
		not path_regexp //
		not header_regexp Cookie (comment_author_|wordpress_logged_in|wp-postpass_)
		not header_regexp X-Wap-Profile (?i)^[a-z0-9"]+
		not header_regexp Profile (?i)^[a-z0-9"]+
		file /wp-content/cache/supercache/{host}{path}index{http.vars.frankenpress_supercache_https}.html
	}
	handle @supercache {
		rewrite * {http.matchers.file.relative}
		# The plugin's own headers for these files (compression adds
		# "Vary: Accept-Encoding" itself)
		header Vary Cookie
		header Cache-Control "max-age=3, must-revalidate"
		header X-FrankenPress-Cache HIT
		# index.html.gz, when the plugin's compression is on
		file_server {
			precompressed gzip
		}
	}

	{$CADDY_SERVER_EXTRA_DIRECTIVES}

	php_server {
		# FrankenPHP passes the proxy's address to PHP by default; hand it the
		# client IP resolved via trusted_proxies so WordPress, login limiters and
		# security plugins see real visitors instead of the load balancer.
		env REMOTE_ADDR {client_ip}
		# Trust and HTTPS decisions for frankenpress-prepend.php (see above)
		env FRANKENPRESS_TRUSTED_PROXY {http.vars.trusted_proxy}
		env FRANKENPRESS_HTTPS {http.vars.frankenpress_https}
	}
}
